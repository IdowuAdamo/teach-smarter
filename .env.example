# Environment & Application Settings
ENVIRONMENT=development
APP_NAME=TeachSmarter
DEBUG=True
DEMO_MODE=True

# Database
# Local SQLite default for rapid development / testing, or PostgreSQL connection string
DATABASE_URL=sqlite+aiosqlite:///./teachsmarter.db
# Production / Docker Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/teachsmarter

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
CLERK_WEBHOOK_SECRET=whsec_replace_with_webhook_secret

# AWS Cloud Services
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_UPLOADS_BUCKET=teachsmarter-uploads-dev
AWS_SES_SENDER_EMAIL=notifications@teachsmarter.internal
AWS_STEP_FUNCTIONS_PERFORMANCE_ARN=arn:aws:states:eu-west-1:123456789012:stateMachine:TeachSmarterPerformanceAnalysis

# AI / LLM Provider (Provider-independent layer)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-mock-key
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Security & Encryption
ENCRYPTION_KEY=32_character_hex_encryption_key_demo
JWT_SECRET=super_secret_jwt_key_for_testing

